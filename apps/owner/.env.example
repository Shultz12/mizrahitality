# mizrahitality-owner — environment variables. Copy to `.env` and fill in.

# Required: SQLite database file. Prisma resolves the relative path from prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Required: secret used to HMAC session tokens before they're stored. The value below is a
# throwaway dev-only secret so `cp .env.example .env && pnpm dev` works out of the box —
# regenerate it for anything non-local: `openssl rand -base64 32`.
SESSION_SECRET="bWl6cmFoaXRhbGl0eS1kZXYtb25seS1zZWNyZXQtY2hhbmdlbWU="

# Used at publish time by feature #4 (ai-copy-and-variants). Not needed to run the skeleton.
ANTHROPIC_API_KEY=""
